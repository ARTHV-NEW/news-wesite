{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string"
        }
      },
      "required": ["firstName", "lastName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Store user profiles"
    }
  }
}
