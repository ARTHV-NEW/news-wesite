rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email == "ghostriderplay120@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "isAdmin" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isSeeding() {
      return !exists(/databases/$(database)/documents/settings/general);
    }

    // Rules for users
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Rules for articles
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for menu
    match /menu/{menuId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for media
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for pages
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for ads
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for tags
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for authors
    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for liveblogs
    match /liveblogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for redirects
    match /redirects/{redirectId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }

    // Rules for shorts
    match /shorts/{shortId} {
      allow read: if true;
      allow write: if isAdmin() || isSeeding();
    }
  }
}
