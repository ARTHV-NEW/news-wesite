rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUser(data) {
      return data.keys().hasAll(['firstName', 'lastName']) &&
             data.keys().hasOnly(['firstName', 'lastName', 'bio', 'avatarUrl']) &&
             data.firstName is string && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100 &&
             (data.get('bio', '') is string && data.get('bio', '').size() <= 500) &&
             (data.get('avatarUrl', '') is string && data.get('avatarUrl', '').size() <= 500);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }
  }
}
